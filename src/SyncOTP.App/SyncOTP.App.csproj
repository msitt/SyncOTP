<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SyncOTP.App</RootNamespace>
    <AssemblyName>SyncOTP</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Bakes the publish flavour into the assembly, so an install with no release.json still knows
      which release zip to fetch. release.yml passes -p:SelfContained= on each publish, and a
      command-line property overrides the value above, so both artifacts stamp themselves correctly.
    -->
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ships next to the exe, so it is inside both release zips. The updater runs the copy from the
      payload it just verified, which keeps the applier and the build it installs in step.
    -->
    <None Include="..\..\scripts\apply-payload.ps1"
          Link="apply-payload.ps1"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncOTP.Core\SyncOTP.Core.csproj" />
  </ItemGroup>

</Project>
