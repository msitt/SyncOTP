<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches SyncOTP.App: a WinForms target framework is required to reference it at all. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- The app sets this; a test host must not be bundled into a single file. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SyncOTP.App\SyncOTP.App.csproj" />
  </ItemGroup>

</Project>
